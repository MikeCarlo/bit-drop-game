{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "bit-drop",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "regular"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a BIT·DROP post",
        "description": "bit-drop",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Report / feedback",
        "description": "Message r/BitDropGame about this app",
        "location": "post",
        "forUserType": "user",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/report"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scheduler": {
    "tasks": {
      "prune-scores": {
        "endpoint": "/internal/triggers/prune-scores",
        "cron": "0 4 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
