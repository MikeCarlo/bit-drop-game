# Copy to `.env` or export in the shell. Bare names and VITE_ names both work.
# vite.config.ts hoists PLATFORM / ENABLE_* into VITE_* for the client bundle.

# Host surface: web (Replit / Vite default) or reddit (Devvit target)
PLATFORM=web

# Web default off (solo). true on web shows the disabled compete stub only.
# The Devvit app forces this on for Reddit 1v1 duels. Do not add an SMS invite here.
ENABLE_MULTIPLAYER=false

# Personal high-score board (localStorage on web; Redis via /api/scores on Reddit)
ENABLE_LEADERBOARD=true
